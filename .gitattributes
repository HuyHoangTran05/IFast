# Harness-managed paths are hashed against .harness-core/manifest.json.
# Pin LF so `harness status` / `harness doctor` do not report false drift
# when the repository is cloned on Windows.
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
.gitignore text eol=lf
docs/** text eol=lf
.agents/** text eol=lf
.harness-core/** text eol=lf

# Vendored upstream source: keep bytes identical to upstream on every platform.
# repository-harness/.gitattributes still pins *.ps1 to CRLF.
repository-harness/** text eol=lf
